# The Gonka PoC image: vLLM 0.30.0 + the decode-PoC residual of this tree + the
# gonka-poc plugin.
#
#   docker build -f docker/Dockerfile.gonka-poc -t vllm-poc:0.30.0 .

ARG BASE_IMAGE=vllm/vllm-openai:v0.30.0
FROM ${BASE_IMAGE}

# FlashInfer JIT-compiles the trtllm MoE kernels on first boot and needs the
# Python headers.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

# The plugin reaches workers over collective_rpc with payloads msgpack cannot
# encode.
ENV VLLM_ALLOW_INSECURE_SERIALIZATION=1
# Deeper shm broadcast rings (~1.3 GiB more /dev/shm per engine).
ENV VLLM_MQ_MAX_CHUNKS=64

# Overlay the residual .py files on the installed package of the same version.
ARG EXPECTED_VLLM_VERSION=0.30.0
COPY ./vllm /tmp/vllm-src
RUN INSTALLED=$(python3 -c "import vllm; print(vllm.__version__)") \
    && case "$INSTALLED" in "${EXPECTED_VLLM_VERSION}"*) ;; \
         *) echo "ERROR: base image ships vllm $INSTALLED, residual targets ${EXPECTED_VLLM_VERSION}"; exit 1 ;; \
       esac \
    && VLLM_DIR=$(python3 -c "import vllm, os; print(os.path.dirname(vllm.__file__))") \
    && cd /tmp/vllm-src \
    && find . -name "*.py" | tar -cf - -T - | tar -xf - -C "$VLLM_DIR/" \
    && rm -rf /tmp/vllm-src

# The plugin, pinned to a tag.
ARG GONKA_POC_REPO=gonka-ai/gonka-vllm-plugins
ARG GONKA_POC_REF=v0.2.0
RUN pip install --no-cache-dir --no-deps \
      "gonka-poc @ https://github.com/${GONKA_POC_REPO}/archive/refs/tags/${GONKA_POC_REF}.tar.gz" \
    && pip install --no-cache-dir "aiohttp>=3.9" "scipy>=1.10"
